# ─── PostgreSQL (dev) ─────────────────────────────────────────────────────────
# Usadas pelo docker-compose.yml quando DB_USER/DB_PASSWORD são sobrescritos
DB_USER=chess
DB_PASSWORD=chess

# ─── PostgreSQL (prod) ────────────────────────────────────────────────────────
# URL completa exigida pelo profile prod
# DATABASE_URL=jdbc:postgresql://host:5432/chessanalyzer?sslmode=require

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Chave de API do provedor de LLM (OpenAI por padrão)
LLM_API_KEY=sk-...
# Provedor: openai | anthropic (default: openai)
LLM_PROVIDER=openai

# ─── Lichess ──────────────────────────────────────────────────────────────────
# Token pessoal em https://lichess.org/account/oauth/token
LICHESS_API_TOKEN=lip_...

# ─── Stockfish ────────────────────────────────────────────────────────────────
# Usado apenas fora do Docker (IDE/terminal). No docker compose, o path é fixo.
# Linux/macOS:  /usr/local/bin/stockfish
# Windows:      C:\stockfish\stockfish.exe
STOCKFISH_PATH=/usr/local/bin/stockfish
