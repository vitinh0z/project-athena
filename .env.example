# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=chessanalyzer
DB_USER=chess
DB_PASSWORD=chess

# URL montada para o Spring Boot (aponta para o container local)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chessanalyzer

# ─── Redis ────────────────────────────────────────────────────────────────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=    # deixe vazio se não configurou senha

# ─── LLM (escolha um provedor) ────────────────────────────────────────────────
# OpenAI / GPT-4o
LLM_API_KEY=sk-...

# ─── Stockfish ────────────────────────────────────────────────────────────────
# Caminho do binário do Stockfish na sua máquina
# Linux/macOS:  /usr/local/bin/stockfish   ou   /usr/games/stockfish
# Windows:      C:\stockfish\stockfish.exe
STOCKFISH_PATH=/usr/local/bin/stockfish
