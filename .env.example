# ─── PostgreSQL (dev) ─────────────────────────────────────────────────────────
# Usadas pelo docker-compose.yml e pelo profile dev do Spring Boot
DB_NAME=chessanalyzer
DB_USER=chess
DB_PASSWORD=chess

# ─── PostgreSQL (prod) ────────────────────────────────────────────────────────
# URL completa exigida pelo profile prod (ex: serviço gerenciado)
# DATABASE_URL=jdbc:postgresql://host:5432/chessanalyzer?sslmode=require

# ─── Redis (dev) ──────────────────────────────────────────────────────────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ─── Redis (prod) ─────────────────────────────────────────────────────────────
# REDIS_URL=redis://user:password@host:6379

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Chave de API do provedor de LLM (OpenAI por padrão)
LLM_API_KEY=sk-...
# Provedor: openai | anthropic (default: openai)
LLM_PROVIDER=openai

# ─── Stockfish ────────────────────────────────────────────────────────────────
# Caminho do binário do Stockfish na sua máquina
# Linux/macOS:  /usr/local/bin/stockfish   |   brew: $(brew --prefix stockfish)/bin/stockfish
# Windows:      C:\stockfish\stockfish.exe
STOCKFISH_PATH=/usr/local/bin/stockfish

# ─── Lichess ──────────────────────────────────────────────────────────────────
# Token pessoal em https://lichess.org/account/oauth/token
LICHESS_API_TOKEN=lip_...
